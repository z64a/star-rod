#
# https://help.github.com/articles/dealing-with-line-endings/
#
# Linux start script should use lf
/gradlew        text eol=lf
/exec/StarRod   text eol=lf

# Windows script files are stored with CRLF and never converted, so every
# checkout, including Nix's hash of a pinned commit, has the same bytes
*.bat           -text

